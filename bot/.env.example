# Copy this file to .env on the server and fill it in. Never commit .env.

# Linnworks: ideally a separate app/login just for the bot (read access is enough)
LINNWORKS_APP_ID=
LINNWORKS_APP_SECRET=
LINNWORKS_TOKEN=
# the warehouse's stock location, by name (or id) as Linnworks shows it
LINNWORKS_LOCATION=Default

# your time zone: the evening list and every "day" follow it
TZ=America/New_York
# when the shopping list is posted (24-hour clock)
DAILY_TIME=19:00

# who may give the bot commands: country code + number, comma separated
ALLOWED_NUMBERS=15551234567,15557654321
# the spare number (country code + number), to link with a code instead of a QR
BOT_PHONE=

# reorder maths, same meaning as in DWS Stock
LEAD_DAYS=7
COVER_DAYS=21
# a sell-out gets its own message right away at this many units/day or more
HOT_PER_DAY=0.5
# how often Linnworks is checked (minutes, 5 or more)
CHECK_MINUTES=15
# a "bought" note clears itself after this many days if nothing arrives
BOUGHT_DAYS=21

# optional: an https webhook (e.g. Make.com -> email) told if WhatsApp logs the bot out
ALERT_WEBHOOK_URL=
